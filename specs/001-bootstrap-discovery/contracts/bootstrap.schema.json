{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://best-in-slot.local/contracts/001-bootstrap-discovery/bootstrap.schema.json",
  "title": "bis bootstrap — JSON output contract",
  "description": "Validates the structured output of `bis bootstrap` subcommands. Used by the bootstrap skill and by any other agent or script driving the CLI in --json mode.",
  "$defs": {
    "RepoRef": {
      "type": "object",
      "required": ["owner", "name", "last_pushed", "is_private", "is_org"],
      "additionalProperties": false,
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "pattern": "^[^/]+$" },
        "last_pushed": { "type": "string", "format": "date-time" },
        "is_private": { "type": "boolean" },
        "is_org": { "type": "boolean" }
      }
    },
    "SkippedSource": {
      "type": "object",
      "required": ["source_id", "reason"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "CategoryProposal": {
      "type": "object",
      "required": [
        "category",
        "category_type",
        "proposed_pick",
        "alternatives",
        "evidence_repo_count",
        "evidence_most_recent",
        "evidence_strength"
      ],
      "additionalProperties": false,
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "category_type": { "enum": ["language", "framework", "tooling"] },
        "proposed_pick": { "type": "string", "minLength": 1 },
        "alternatives": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_repo_count": { "type": "integer", "minimum": 1 },
        "evidence_most_recent": { "type": "string", "format": "date-time" },
        "evidence_strength": { "type": "number", "minimum": 0 },
        "confidence_qualifier": {
          "enum": ["high", "medium", "low", "conflicting", null]
        }
      }
    },
    "SlotDecision": {
      "type": "object",
      "required": ["category", "action", "was_proposal_unchanged", "decided_at"],
      "additionalProperties": false,
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "action": {
          "enum": [
            "accept",
            "change",
            "skip",
            "defer",
            "split",
            "merge",
            "rename",
            "drop",
            "add"
          ]
        },
        "chosen_pick": { "type": ["string", "null"] },
        "into": {
          "type": ["array", "null"],
          "items": { "type": "string", "minLength": 1 }
        },
        "merge_with": { "type": ["string", "null"] },
        "new_name": { "type": ["string", "null"] },
        "new_category_type": {
          "enum": ["language", "framework", "tooling", null]
        },
        "was_proposal_unchanged": { "type": "boolean" },
        "decided_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "enum": ["accept", "change", "add"] } } },
          "then": {
            "properties": { "chosen_pick": { "type": "string", "minLength": 1 } },
            "required": ["chosen_pick"]
          }
        },
        {
          "if": { "properties": { "action": { "enum": ["skip", "defer", "split", "merge", "rename", "drop"] } } },
          "then": {
            "properties": { "chosen_pick": { "type": "null" } }
          }
        },
        {
          "if": { "properties": { "action": { "const": "merge" } } },
          "then": {
            "properties": { "merge_with": { "type": "string", "minLength": 1 } },
            "required": ["merge_with"]
          }
        },
        {
          "if": { "properties": { "action": { "const": "rename" } } },
          "then": {
            "properties": { "new_name": { "type": "string", "minLength": 1 } },
            "required": ["new_name"]
          }
        },
        {
          "if": { "properties": { "action": { "const": "add" } } },
          "then": {
            "properties": {
              "new_category_type": { "enum": ["language", "framework", "tooling"] }
            },
            "required": ["new_category_type"]
          }
        }
      ]
    },
    "StructureChange": {
      "type": "object",
      "required": ["kind", "category", "applied_at"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["split", "merge", "rename", "drop", "add"] },
        "category": { "type": "string", "minLength": 1 },
        "into": {
          "type": ["array", "null"],
          "items": { "type": "string", "minLength": 1 }
        },
        "merge_with": { "type": ["string", "null"] },
        "new_name": { "type": ["string", "null"] },
        "new_pick": { "type": ["string", "null"] },
        "new_category_type": {
          "enum": ["language", "framework", "tooling", null]
        },
        "applied_at": { "type": "string", "format": "date-time" }
      }
    },
    "TaxonomyReviewProposal": {
      "type": "object",
      "required": ["category", "category_type", "proposed_pick", "members"],
      "additionalProperties": false,
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "category_type": { "enum": ["language", "framework", "tooling"] },
        "proposed_pick": { "type": "string", "minLength": 1 },
        "members": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "suggest_split_into": {
          "type": ["array", "null"],
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "oneOf": [
    {
      "title": "bis bootstrap --json --batch result",
      "description": "Full proposal set, no walk-through prompts. Returned in one document.",
      "type": "object",
      "required": ["mode", "run_id", "started_at", "proposals", "skipped_sources"],
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "batch" },
        "run_id": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "format": "date-time" },
        "proposals": {
          "type": "array",
          "items": { "$ref": "#/$defs/CategoryProposal" }
        },
        "skipped_sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/SkippedSource" }
        },
        "on_existing_choice": {
          "enum": ["merge", "replace", "skip", null]
        },
        "deferred_categories_resurfaced": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    {
      "title": "bis bootstrap confirm result",
      "description": "Result of applying a single user decision to one proposed slot. For structure actions (split/merge/rename/drop/add), `structure_change` is populated; for pick actions (accept/change/skip/defer), `slot_yaml_written` is populated when a slot file was written.",
      "type": "object",
      "required": ["mode", "decision"],
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "confirm" },
        "decision": { "$ref": "#/$defs/SlotDecision" },
        "slot_yaml_written": { "type": ["string", "null"] },
        "structure_change": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/StructureChange" }
          ]
        }
      }
    },
    {
      "title": "bis bootstrap taxonomy-review result",
      "description": "Pre-walk overview of the full proposal set, with per-proposal split suggestions where the heuristic table can offer one. Emitted by `bis bootstrap taxonomy-review --json`.",
      "type": "object",
      "required": ["mode", "run_id", "proposals"],
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "taxonomy-review" },
        "run_id": { "type": "string", "minLength": 1 },
        "proposals": {
          "type": "array",
          "items": { "$ref": "#/$defs/TaxonomyReviewProposal" }
        }
      }
    },
    {
      "title": "bis bootstrap error",
      "description": "Returned when the CLI cannot proceed.",
      "type": "object",
      "required": ["mode", "error"],
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "error" },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "existing_state_unresolved",
                "no_repos_in_window",
                "gh_auth_missing",
                "scanner_failed",
                "unknown_category",
                "split_not_supported",
                "merge_incompatible_types",
                "no_prior_proposal"
              ]
            },
            "message": { "type": "string", "minLength": 1 },
            "hint": { "type": "string" }
          }
        }
      }
    }
  ]
}
